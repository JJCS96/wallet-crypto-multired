# Configuración para `npm run dev:emulators`: Auth y Firestore locales.
# Son valores de demostración (proyecto "demo-*"), no credenciales reales.
VITE_USE_FIREBASE_EMULATORS=true
VITE_FIREBASE_API_KEY=demo-api-key
VITE_FIREBASE_AUTH_DOMAIN=demo-novawallet.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=demo-novawallet
VITE_FIREBASE_STORAGE_BUCKET=demo-novawallet.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=000000000000
VITE_FIREBASE_APP_ID=1:000000000000:web:demo
VITE_BNB_TESTNET_RPC_URL=https://data-seed-prebsc-1-s1.bnbchain.org:8545
VITE_BITCOIN_TESTNET_API_URL=https://mempool.space/testnet/api
